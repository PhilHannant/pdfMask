{
  "name": "pdfmask",
  "compatibility_date": "2026-10-16",
  // Build the site before every deploy: copy the libraries into vendor/ and
  // minify app.js. The tools can't load without vendor/, so if this step
  // can't run, the deploy fails and the current site stays up, which is
  // better than publishing a broken one.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./",
    // /redact-pdf/ serves redact-pdf/index.html, and /redact-pdf redirects to /redact-pdf/.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get 404.html with a proper 404 status.
    "not_found_handling": "404-page"
  },
  // Pull request branches are built as Worker Previews (npx wrangler preview),
  // which needs this block. The site has no variables or bindings, so there is
  // nothing to override and it stays empty. Assets stay at the top level.
  "previews": {}
}
